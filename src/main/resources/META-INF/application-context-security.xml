<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:mvc="http://www.springframework.org/schema/mvc"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
         http://www.springframework.org/schema/mvc http://www.springframework.org/schema/mvc/spring-mvc.xsd">

    <!-- Bearer-token authorization for controllers annotated with @RequiresApiRole.
         Tokens come from the environment (or -D system properties); unset tokens fail closed. -->
    <mvc:interceptors>
        <bean class="com.mycompany.entapp.snowman.infrastructure.rest.security.ApiTokenAuthorizationInterceptor">
            <property name="adminToken" value="${SNOWMAN_ADMIN_API_TOKEN:}"/>
            <property name="readerToken" value="${SNOWMAN_READER_API_TOKEN:}"/>
        </bean>
    </mvc:interceptors>

</beans>
