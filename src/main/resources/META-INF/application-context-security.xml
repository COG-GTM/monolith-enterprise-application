<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:mvc="http://www.springframework.org/schema/mvc"
       xsi:schemaLocation="http://www.springframework.org/schema/mvc http://www.springframework.org/schema/mvc/spring-mvc.xsd
         http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- Bearer-token authentication for the REST API (tokens come from application.properties / environment) -->
    <mvc:interceptors>
        <mvc:interceptor>
            <mvc:mapping path="/project/**"/>
            <bean class="com.mycompany.entapp.snowman.infrastructure.rest.security.ApiTokenAuthInterceptor">
                <constructor-arg index="0" value="${snowman.api.token:}"/>
                <constructor-arg index="1" value="${snowman.api.readonly-token:}"/>
            </bean>
        </mvc:interceptor>
    </mvc:interceptors>

</beans>
