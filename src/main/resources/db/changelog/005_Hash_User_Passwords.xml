<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.0.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <changeSet id="1" author="snowman">
        <comment>Widen user.password to hold PBKDF2 hashes and clear plain text passwords</comment>
        <modifyDataType tableName="user" columnName="password" newDataType="VARCHAR(255)"/>
        <sql>
            update user set password = null where password is not null and password not like 'pbkdf2_sha256$%';
        </sql>
        <rollback>
            <modifyDataType tableName="user" columnName="password" newDataType="VARCHAR(20)"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
